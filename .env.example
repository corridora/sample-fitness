# ./setup configure saves these as protected JSON. Export variables for CI;
# do not commit a populated copy or pass secrets as setup CLI arguments.
SAMPLE_MODE=local
PORT=4104
CORRIDORA_TARGET=own
CORRIDORA_OTLP_ENDPOINT=https://ingest.corridora.com
CORRIDORA_INGEST_KEY=
CORRIDORA_RUM_KEY=
CORRIDORA_RUM_SCRIPT_URL=https://rum.corridora.com/corridora-rum.js
OTEL_SERVICE_NAME=sample-fitness-api
OTEL_SERVICE_NAMESPACE=corridora-samples.fitness
DEPLOYMENT_ENVIRONMENT=development
DEMO_CONTROL_TOKEN=
DEMO_DAILY_START_UTC=14:00
DEMO_WINDOW_SECONDS=600
ENABLE_PROVIDER_FORWARDING=false
ENABLE_SYNTHETICS=false
RECOMMENDER_URL=
DOWNSTREAM_AUTH_TOKEN=
PUBLIC_URL=
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=corridora-fitness
RESOURCE_PREFIX=fitdemo
EXISTING_RESOURCE_GROUP=false
AZURE_EXISTING_COSMOS_NAME=
COSMOS_FREE_TIER=true
IMAGE_REPOSITORY=ghcr.io/corridora/sample-fitness
